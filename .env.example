# Copy to /etc/velib-pulse/producers.env (never commit the real file)
KAFKA_BOOTSTRAP=kafka1:9092
# Local NDJSON.gz safety archive (also used by --archive-only mode)
ARCHIVE_DIR=/var/lib/velib-pulse/archive
LOG_LEVEL=INFO
# Optional overrides
# VELIB_BASE_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole
# POLL_SECONDS=60
# Later checkpoints (TimescaleDB / Grafana) — keep secrets out of Git
# TSDB_URL=postgresql://velib:CHANGE_ME@vm2:5432/velib
