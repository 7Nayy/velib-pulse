[Unit]
Description=Vélib' Pulse - Open-Meteo weather producer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=velib
WorkingDirectory=/opt/velib-pulse/producers
EnvironmentFile=/etc/velib-pulse/producers.env
ExecStart=/opt/velib-pulse/.venv/bin/python weather_producer.py
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
